# Change these two values before exposing the service to the internet.
ADMIN_TOKEN=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:change-me@db:5432/sentinel
APP_NAME=Sentinel AI
PUBLIC_URL=http://localhost:8000
# На VPS без домена используйте 127.0.0.1 и открывайте панель через SSH-туннель.
BIND_ADDRESS=0.0.0.0
CHECK_TICK_SECONDS=10
INCIDENT_COOLDOWN_MINUTES=15
LOG_LEVEL=INFO

# Local Qwen via Ollama. On macOS/Windows, host.docker.internal reaches Ollama on the host.
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:latest
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# Optional. Get these from @BotFather and @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько дней хранить отдельные SQL-бэкапы на сервере.
BACKUP_RETENTION_DAYS=14
