# Обязательные секреты. Используйте только латинские буквы и цифры в пароле БД.
ADMIN_TOKEN=PASTE_A_LONG_RANDOM_TOKEN
POSTGRES_PASSWORD=PASTE_A_LONG_DATABASE_PASSWORD

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:PASTE_A_LONG_DATABASE_PASSWORD@db:5432/sentinel
APP_NAME=Sentinel AI
PUBLIC_URL=http://localhost:8000

# Панель доступна только самому серверу. Подключение — через SSH-туннель.
BIND_ADDRESS=127.0.0.1
CHECK_TICK_SECONDS=10
INCIDENT_COOLDOWN_MINUTES=15
LOG_LEVEL=INFO

# На VPS Qwen выключен по умолчанию. Мониторинг и Telegram работают без него.
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:latest
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN
TELEGRAM_CHAT_ID=PASTE_CHAT_ID
BACKUP_RETENTION_DAYS=14
